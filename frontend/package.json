{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:landing": "vite build",
    "build:dashboard": "vite build --config vite.dashboard.config.ts && node -e \"const fs = require('fs'); if (fs.existsSync('dashboard-react/dashboard-react.html')) { fs.renameSync('dashboard-react/dashboard-react.html', 'dashboard-react/index.html'); }\"",
    "build": "npm run build:landing && npm run build:dashboard",
    "preview": "vite preview",
    "clean": "rm -rf dist dashboard-react server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.17.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.417.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
